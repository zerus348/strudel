// Midtempo bass song for learning

await samples('http://localhost:5173/strudel.json')

setcpm(108 / 4)

const rootProgression = n("<0 0 3 1>")
const alternateProgression = n("<0 0 1 0>")
const fadeIn = saw.slow(1) // fade in

const leadCut = slider(3500, 300, 8000)

const kick = stack(
    n("c*4").s("sine").penv(36).pdecay(.045).decay(.3).sustain(0).distort("2:.45"),
    s("bd*4").bank("RolandTR909").lpf(2500)
).duck("3:4:5:6")
    .duckdepth(.7)
    .duckattack(.16)
    ._pianoroll()

const snare = stack(
    s("~ cp ~ cp").bank("RolandTR909").room(.08),
    s("~ sd ~ sd").bank("RolandTR909").lpf(4500).distort("1:.5:hard"))
    ._pianoroll()

const hat = s("hh(3,16,2)")
    .bank("RolandTR909")
    .hpf(1500)
    .lpf(6500)
    .gain(1.1)
    ._pianoroll()

const rim = s("rim(3,8,1)")
    .bank("RolandTR909")
    .lpf(3000)
    .gain(1.2)
    .room(.2)
    ._pianoroll()

const bass =
    n("<0@3 ~ 0@3 ~ [0 0] 0@3 ~ [0 12]@2 ~>*16") // offset beat
        //     n("<~ 0 0 ~ ~ 0 ~ 0 ~ 0 0 ~ ~ 0 ~ [0 12]>*16") // syncopated beat
        // n("<0@3 ~ 0@3 ~ ~ ~ ~ 0@3 ~ ~>*16").late(.05) // irregular rhythm, offset to 4/4 beat
        .add(rootProgression)
        .scale("c2:phrygian")
        .s("sawtooth")
        .att(0.3)
        .lpf(sine.range(250, 700).slow(4))
        .lpq(7)
        .lpa(.5)
        .distort("3:.4:fold")
        .decay(.8)
        .sustain(.5)
        .gain(.9)
        .o(4)
        ._pianoroll()
        ._scope()

const pulse = n("<0!4 0 0 0>*16")
    .add(rootProgression)
    .scale("C2:phrygian")
    .s("triangle").lpf(180).decay(.25).sustain(.2)
    .gain(sine.range(.6, .9).slow(4))
    .room(.4)
    .o(4)
    ._pianoroll()

const lead = n("<4 0>*16")
    .add(rootProgression)
    .mask("<1 0 1 0 1 0 1 0>")
    .scale("C3:phrygian") // use C2.phrygian for a bassier sound
    .s("sawtooth")
    .lpf(fadeIn.range(250, 3000).mul(leadCut.div(3500)))
    .lpq(fadeIn.range(1, 14))
    .distort(fadeIn.range(0, 6)).decay(.1).sustain(0).gain(fadeIn.range(.06, .5))
    .delay(.1).delaytime(.3).delayfeedback(.6)
    .room(.5).roomsize(6)
    .postgain(.4)
    .o(3)
    ._pianoroll()

const introBass = n("0*4")
    .slow(4)
    // .cut(1.9)
    .scale("C2:phrygian")
    .s("supersaw")
    .unison(5).detune(.8).spread(.9)
    .penv(2).pattack(.3).pdecay(0.8).psustain(-2).panchor(0)
    .attack(.05).sustain(1).release(.1)
    .lpf(fadeIn.range(300, 2500).slow(4)).lpq(8)   // optional: opens up over the intro
    .distort("3:.5").gain(.5)
    .phaser(sine.range(.3, .5)).phaserdepth(.6)
    .room(.4)
    .delay("<0 0 0 0 .15 .4 .6 0>").delaytime(.4167).delayfeedback(.65).delaysync(1)
    .room("<0 0 0 0 .1 .2 .8 0>").roomfade(.6)
    .mask("<1 1 1 1 1 1 1 0>")
    .o(5)
    ._pianoroll()

const introFill = s("~@12 ht mt lt lt")
    .bank("RolandTR909")
    .lpf(2500).distort("2:.4").room(.3)
    ._pianoroll()

// $: kick
// $: snare
// $: hat
// $: rim
// S: bass
// $: pulse
// _$: lead

const intro = stack(
    introBass,
)

const partA = stack(
    kick,
    snare,
    hat,
    rim,
    bass,
    pulse,
)

const partB = stack(
    partA,
    lead
)

$main: stack(
    seqPLoop(
        [0, 7, intro],
        [7, 8, introFill],
        [8, 16, partA],
        [16, 23, partB],
    )
)