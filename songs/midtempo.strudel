// Midtempo bass song for learning

setcpm(108 / 4)

const leadLineA = "<4 0>*16"
const leadLineB = "<0 2 4 7>*16"
const leadLineC = "<0 7 4 2>*16"

const rootProgression = n("<0 0 1 0>")
const alternateProgression = n("<0 0 3 1>")
const fadeIn = saw.slow(1) // fade in

const leadCut = slider(3500, 300, 8000)

const kick = stack(
    n("c1*4").s("sine").penv(48).pdecay(.03).decay(.2).sustain(0).distort("3:.4"),
    s("bd*4").bank("RolandTR909").hpf(120).lpf(5000)
).duck("3:4:5:6")
    .duckdepth(.85)
    .duckattack(.1)
    ._pianoroll()

const snare = stack(
    s("~ cp ~ cp").bank("RolandTR909").room(.08),
    s("~ sd ~ sd").bank("RolandTR909").lpf(4500).distort("1:.5:hard"))
    ._pianoroll()

const hat = stack(
    s("white(3,16,2)").att(.75).hpf(1300).penv(80).pdecay(.1),
    s("hh(3,16,2)")
        .bank("RolandTR909")
        .distort("1.2:.6:hard")
        .hpf(1500)
        .lpf(6500)
)
    .room(.1)
    .o(6)
    ._pianoroll()


const rim = stack(
    s("white(3,16,2)").att(.75).hpf(1300).penv(80).pdecay(.1),
    s("rim(3,8,1)")
        .bank("RolandTR909")
        .hpf(1500)
        .lpf(6500)
        .distort("1.4:.9:hard")
)
    .room(.1)
    .o(6)
    ._pianoroll()

const bass = (progression) =>
    n("<0@3 ~ 0@3 ~ [0 0] 0@3 ~ [0 12]@2 ~>*16") // offset beat
        //     n("<~ 0 0 ~ ~ 0 ~ 0 ~ 0 0 ~ ~ 0 ~ [0 12]>*16") // syncopated beat
        // n("<0@3 ~ 0@3 ~ ~ ~ ~ 0@3 ~ ~>*16").late(.05) // irregular rhythm, offset to 4/4 beat
        .add(progression)
        .scale("c2:phrygian")
        .s("sawtooth")
        .att(0.3)
        .lpf(sine.range(250, 700).slow(4))
        .lpq(7)
        .lpa(.5)
        .distort("3:.4:fold")
        .decay(.8)
        .sustain(.5)
        .gain(.9)
        .o(4)
        ._pianoroll()
        ._scope()

const pulse = (progression) =>
    n("<0!4 0 0 0>*16")
        .add(progression)
        .scale("C2:phrygian")
        .s("triangle").lpf(180).decay(.25).sustain(.2)
        .gain(sine.range(.6, .9).slow(4))
        .room(.4)
        .o(4)
        ._pianoroll()

const lead = (leadLine, progression) =>
    n(leadLine)
        .add(progression)
        .mask("<1 0 1 0 1 0 1 0>")
        .scale("C3:phrygian") // use C2.phrygian for a bassier sound
        .s("sawtooth")
        .lpf(fadeIn.range(250, 3000).mul(leadCut.div(3500)))
        .lpq(fadeIn.range(1, 14))
        .distort(fadeIn.range(0, 6)).decay(.1).sustain(0).gain(fadeIn.range(.06, .15))
        .delay(.1).delaytime(.3).delayfeedback(.6)
        .room(.5).roomsize(6)
        .postgain(.4)
        .o(3)
        ._pianoroll()

const leadHigh = (progression) =>
    n("<7 ~ 8 7>")           // one note per cycle: root, rest, ♭2, root
        .add(progression)
        .scale("C3:phrygian")                  // degree 7 = root an octave up
        .s("supersaw").unison(3).detune(.3).spread(.7)
        .attack(.05).sustain(.6).release(.4)
        .lpf(2500).lpq(4)
        .gain(.3)
        .delay(.3).delaytime(.4167).delayfeedback(.5)
        .o(7)                                  // own orbit: its delay/room won't affect the lead's
        ._pianoroll()

const introBass = n("0*4")
    .slow(4)
    // .cut(1.9)
    .scale("C2:phrygian")
    .s("supersaw")
    .unison(5).detune(.8).spread(.9)
    .penv(2).pattack(.3).pdecay(0.8).psustain(-2).panchor(0)
    .attack(.05).sustain(1).release(.1)
    .lpf(fadeIn.range(300, 2500).slow(4)).lpq(8)   // optional: opens up over the intro
    .distort("3:.5").gain(.5)
    .phaser(sine.range(.3, .5)).phaserdepth(.6)
    .room(.4)
    .delay("<0 0 0 0 .15 .4 .6 0>").delaytime(.4167).delayfeedback(.65).delaysync(1)
    .room("<0 0 0 0 .1 .2 .8 0>").roomfade(.6)
    .mask("<1 1 1 1 1 1 1 0>")
    .o(5)
    ._pianoroll()

const introFill = s("~@12 ht mt lt lt")
    .bank("RolandTR909")
    .lpf(2500).distort("2:.4").room(.3)
    ._pianoroll()

const intro = stack(
    introBass,
)

const basePart = (progression) =>
    stack(
        kick,
        snare,
        hat,
        rim,
        bass(progression),
        pulse(progression),
    )

const partA = (progression) =>
    stack(
        basePart(progression),
        leadHigh(progression).mask("<1 0>"),
        lead(leadLineA, progression).mask("<0 1>"),
    )

const partB = (progression) =>
    stack(
        basePart(progression),
        leadHigh(progression),
        lead(leadLineA, progression),
    )

const partC = (progression) =>
    stack(
        basePart(progression),
        leadHigh(progression).phaser(sine.range(.5, .8)).phaserdepth(.4),
        lead(leadLineB, progression).off(1 / 8, add(7)),
    )

const partD = (progression) =>
    stack(
        basePart(progression),
        leadHigh(progression).phaser(sine.range(.5, .8)).phaserdepth(.4),
        lead(leadLineB, progression).off(1 / 8, add(7)),
        lead(leadLineC, progression).off(1 / 8, add(7)),
    )

const partE = (progression) =>
    stack(
        basePart(progression),
        lead(leadLineC, progression).off(1 / 8, add(7)),
    )

const outro = lead(leadLineB, rootProgression).off(1 / 8, add(7))

const main = stack(
    seqPLoop(
        [0, 7, intro],
        [7, 8, introFill],
        [8, 16, basePart(rootProgression)],
        [16, 20, partA(rootProgression)],
        [20, 24, partA(alternateProgression)],
        [24, 28, partB(rootProgression)],
        [28, 32, partB(alternateProgression)],
        [32, 36, partC(alternateProgression)],
        [36, 40, partC(rootProgression)],
        [40, 44, partD(rootProgression)],
        [44, 48, partE(rootProgression)],
        [47, 49, outro],
        [49, 50, silence],
    )
)

$: main
