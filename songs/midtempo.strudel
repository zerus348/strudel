// Midtempo bass song for learning

setcpm(108 / 4)

const leadLineA = "<4 0>*16"
const leadLineB = "<0 2 4 7>*16"
const leadLineC = "<0 7 4 2>*16"

const introProgression = "<[0,4,7,9] [0,2,5,7] [0,3,5,7] [0,4,7,9]>/2"

const rootProgression = "<0 0 1 0>"
const alternateProgression = "<0 0 3 1>"
const fadeIn = saw.slow(1) // fade in

const leadCut = slider(3500, 300, 8000)

const kick = stack(
    n("c1*4").s("sine").penv(48).pdecay(.03).decay(.2).sustain(0).distort("3:.4"),
    s("bd*4").bank("RolandTR909").hpf(120).lpf(5000)
).duck("3:4:6")
    .duckdepth(.8)
    .duckattack(.2)
    ._pianoroll()

const snare = stack(
    s("~ cp ~ cp").bank("RolandTR909").room(.08),
    s("~ sd ~ sd").bank("RolandTR909").lpf(4500).distort("1:.5:hard"))
    ._pianoroll()

const hat = stack(
    s("white(3,16,2)").att(.75).hpf(1300).penv(80).pdecay(.1),
    s("hh(3,16,2)")
        .bank("RolandTR909")
        .distort("1.2:.6:hard")
        .hpf(1500)
        .lpf(6500)
)
    .room(.1)
    .o(6)
    ._pianoroll()


const rim = stack(
    s("white(3,16,2)").att(.75).hpf(1300).penv(80).pdecay(.1),
    s("rim(3,8,1)")
        .bank("RolandTR909")
        .hpf(1500)
        .lpf(6500)
        .distort("1.4:.9:hard")
)
    .room(.1)
    .o(6)
    ._pianoroll()

const bass = (progression) =>
    n("<0@3 ~ 0@3 ~ [0 0] 0@3 ~ [0 12]@2 ~>*16") // offset beat
        //     n("<~ 0 0 ~ ~ 0 ~ 0 ~ 0 0 ~ ~ 0 ~ [0 12]>*16") // syncopated beat
        // n("<0@3 ~ 0@3 ~ ~ ~ ~ 0@3 ~ ~>*16").late(.05) // irregular rhythm, offset to 4/4 beat
        .add(progression)
        .scale("c2:phrygian")
        .s("sawtooth")
        .att(0.3)
        .lpf(sine.range(250, 700).slow(4))
        .lpq(7)
        .lpa(.5)
        .distort("3:.4:fold")
        .decay(.8)
        .sustain(.5)
        .gain(.8)
        .o(4)
        ._pianoroll()
        ._scope()

const pulse = (progression) =>
    n("<0!4 0 0 0>*16")
        .add(progression)
        .scale("C2:phrygian")
        .s("triangle").lpf(180).decay(.25).sustain(.2)
        .gain(sine.range(.6, .9).slow(4))
        .room(.4)
        .o(4)
        ._pianoroll()

const lead = (leadLine, progression) =>
    n(leadLine)
        .add(progression)
        .mask("<1 0 1 0 1 0 1 0>")
        .scale("C3:phrygian") // use C2.phrygian for a bassier sound
        .s("sawtooth")
        .lpf(fadeIn.range(250, 3000).mul(leadCut.div(3500)))
        .lpq(fadeIn.range(1, 14))
        .distort(fadeIn.range(0, 6)).decay(.1).sustain(0).gain(fadeIn.range(.06, .15))
        .delay(.1).delaytime(.4167).delayfeedback(.5)
        .room(.5).roomsize(6)
        .postgain(.4)
        .o(3)
        ._pianoroll()

const leadHigh = (progression) =>
    n("<7 ~ 8 7>")           // one note per cycle: root, rest, ♭2, root
        .add(progression)
        .scale("C3:phrygian")                  // degree 7 = root an octave up
        .s("supersaw").unison(3).detune(.3).spread(.7)
        .attack(.05).sustain(.6).release(.4)
        .lpf(2500).lpq(4)
        .gain(.3)
        .delay(.3).delaytime(.4167).delayfeedback(.5)
        .o(7)                                  // own orbit: its delay/room won't affect the lead's
        ._pianoroll()

const introBass = n("0*4")
    .slow(4)
    .scale("C2:phrygian")
    .s("supersaw")
    .unison(5).detune(.8).spread(.9)
    .penv(2).pattack(.3).pdecay(0.8).psustain(-2).panchor(0)
    .attack(.05).sustain(1).release(.1)
    .lpf(fadeIn.range(300, 2500).slow(4)).lpq(8)   // optional: opens up over the intro
    .distort("3:.5").postgain(.5)
    .phaser(sine.range(.3, .5)).phaserdepth(.6)
    .room(.4)
    .delay("<0 0 0 0 .15 .4 .6 0>").delaytime(.4167).delayfeedback(.65).delaysync(1)
    .room("<0 0 0 0 .1 .2 .8 0>").roomfade(.6)
    .o(5)
    ._pianoroll()

const introPad = (progression) =>
    n(progression)
        .scale("C3:phrygian")
        .s("supersaw").unison(4)
        .detune(sine.range(.3, .8).slow(8))         // different periods so the motion
        .lpf(perlin.range(500, 2500).slow(7))       // never lines up
        .pan(perlin.range(.25, .75).slow(5))
        .attack(1.2).sustain(1).release(1.2)
        .hpf(150).gain(.25)
        // .lpenv(3).lpa(1.5)
        .room(.9).roomsize(8)

const introShimmer = (progression) =>
    n(progression)
        .scale("C4:phrygian")                       // same chord, one octave up
        .s("supersaw").unison(3).detune(1).spread(1)
        .attack(2).sustain(1).release(4)
        .hpf(1500).lpf(7000)                        // only the airy top
        .pan(perlin.range(.1, .9).slow(3))          // wanders more than the pad
        .delay(.4).delaytime(.4167).delayfeedback(.6)
        .room(1).roomsize(10)
        .gain(.08)

const introAtmos = (progression) =>
    n(progression)
        .scale("C4:phrygian")
        .s("gm_pad_choir:1,gm_pad_choir:4,gm_pad_choir") //4,ohne,1
        .attack(2).release(3)
        .lpf(2500).gain(.2)
        .room(.9).roomsize(8)

const introFill = s("~@12 ht mt lt lt")
    .bank("RolandTR909")
    .lpf(2500).distort("2:.4").room(.3)
    ._pianoroll()

const intro = stack(
    introAtmos(introProgression).mask("<1@21 0@3>"),
    introPad(introProgression).mask("<0@8 1@14 0@2>"),
    introShimmer(introProgression).mask("<0@12 1@10 0@2>"),
    introBass.mask("<0@16 <1@2 0 0>@2>"),
)

const basePart = (progression) =>
    stack(
        kick,
        snare,
        bass(progression),
        pulse(progression),
    )

const partA = (progression) =>
    stack(
        basePart(progression),
        hat,
        rim,
        leadHigh(progression).mask("<1 0>"),
        lead(leadLineA, progression).mask("<0 1>"),
    )

const partB = (progression) =>
    stack(
        basePart(progression),
        hat,
        rim,
        leadHigh(progression),
        lead(leadLineA, progression),
    )

const partC = (progression) =>
    stack(
        basePart(progression),
        hat,
        rim,
        leadHigh(progression).phaser(sine.range(.5, .8)).phaserdepth(.4),
        lead(leadLineB, progression).off(1 / 8, add(7)),
    )

const partD = (progression) =>
    stack(
        basePart(progression),
        hat,
        rim,
        leadHigh(progression).phaser(sine.range(.5, .8)).phaserdepth(.4),
        lead(leadLineB, progression).off(1 / 8, add(7)),
        lead(leadLineC, progression).off(1 / 8, add(7)),
    )

const partE = (progression) =>
    stack(
        basePart(progression),
        lead(leadLineC, progression).off(1 / 8, add(7)),
    )

const outro = stack(
    kick.gain(saw.slow(8).range(1, 0)),
    snare.gain(saw.slow(8).range(1, 0)),
    bass(rootProgression).gain(saw.slow(8).range(1, 0)),
    pulse(rootProgression).gain(saw.slow(8).range(1, 0)),
    lead(leadLineB, rootProgression).off(1 / 8, add(7)).gain(saw.slow(8).range(1, .5)),
)

const main = seqPLoop(
    [0, 23, intro],
    [23, 24, introFill],
    [24, 28, basePart(rootProgression)],
    [28, 32, partA(rootProgression)],
    [32, 36, partA(alternateProgression)],
    [36, 40, partB(rootProgression)],
    [40, 44, partB(alternateProgression)],
    [44, 48, partC(alternateProgression)],
    [48, 52, partC(rootProgression)],
    [52, 56, partD(rootProgression)],
    [56, 60, partE(rootProgression)],
    [60, 68, outro],
    [68, 72, silence],
)

$: main
